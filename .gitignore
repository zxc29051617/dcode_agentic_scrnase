__pycache__/
*.pyc
.claude/settings.local.json
runs/
.claude/settings.local.json.tmp.*

# References are 20-32 GB and machine-specific; reference/README.md says how to get one.
reference/*
!reference/README.md

# Datasets and third-party tools: ~27 GB, fetched not committed.
# data/README.md and tools/README.md say how to get them.
data/*
!data/README.md
tools/*
!tools/README.md
.env

# Analyses kept by hand; reports and figures are generated outputs, not source.
results/*
!results/README.md

# Claude worktrees are separate checkouts of this repository.
.claude/worktrees/

# The controller's dataset allowlist names paths on this machine, and its
# database holds requests and operator identities. Neither is source; the
# committed example says what shape they take.
config/dataset_catalog.json
services/controller/.venv/
services/controller/*.sqlite*

# Local service state: the controller's database lives here. Not a run
# directory — only the scientific worker writes under runs/ — and not source.
var/

# Incremental type-check cache, written by `tsc` and `next build`. A 400 KB
# generated file that changes on every build; not source.
tsconfig.tsbuildinfo
