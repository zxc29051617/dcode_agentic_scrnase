# Copy to `.env` and adjust. `.env` is gitignored; this file is not.
#
# The judge talks to any OpenAI-compatible endpoint. Ollama serves one at /v1 —
# the suffix matters, /api/tags is Ollama's own API and langchain will not use it.

# Lab DGX. The hostname needs the lab DNS; the address works from anywhere on
# the subnet, including from inside a container where localhost is not the host.
SCRNA_JUDGE_BASE_URL=http://lsbnb-dgx2.iis.sinica.edu.tw:11434/v1
# SCRNA_JUDGE_BASE_URL=http://192.168.81.7:11434/v1

# Verified on this server: strict json_schema structured output works, and one
# verdict on a real apply_cell_qc_filter payload takes about 12 seconds.
SCRNA_JUDGE_MODEL=gpt-oss:20b

# Ollama ignores the key, but the OpenAI client insists on one being set.
SCRNA_JUDGE_API_KEY=not-needed

# `stub` needs no model at all and is what the tests use.
SCRNA_JUDGE_BACKEND=stub
