# Copy to .env.local (gitignored) and adjust. Nothing in this example file is
# a real credential.
#
# Read only from Server Components and Route Handlers (see lib/gateway.ts and
# app/api/copilotkit/route.ts) — never given the NEXT_PUBLIC_ prefix, which is
# the one thing in Next.js that ships a value into the browser bundle.

# The gateway this app reads from. The browser never talks to this URL
# directly — every page fetches it through lib/gateway.ts, server-side.
GATEWAY_URL=http://127.0.0.1:8010

# @copilotkit/runtime sends anonymous telemetry by default (a real outbound
# call this repo's other services do not make without being asked). Off by
# default here, matching this project's existing rule that nothing leaves the
# machine that was not explicitly turned on — see docs/judge_setup.md.
COPILOTKIT_TELEMETRY_DISABLED=true

# Left unset in Phase 1 on purpose: no real model endpoint or API key was
# available to wire in (no local Ollama running, no .env for the project's own
# judge endpoint, no key provided). app/api/copilotkit/route.ts falls back to
# @copilotkit/runtime's ExperimentalEmptyAdapter when this is unset, so the
# assistant page still exercises the real request/response path against the
# real gateway data with no model call. Set this to point the assistant at a
# real OpenAI-compatible endpoint once one is approved — see
# docs/copilotkit_product_architecture.md "model-egress policy".
# ASSISTANT_MODEL_BASE_URL=
# ASSISTANT_MODEL_API_KEY=
