# Copy to .env.local (gitignored) and adjust. Nothing in this example file is
# a real credential, and nothing here is read anywhere but on the server.
#
# None of these names carries the NEXT_PUBLIC_ prefix, which is the one thing
# in Next.js that inlines a value into client-side JavaScript. GATEWAY_URL is
# read only in lib/gateway.ts and the ASSISTANT_MODEL_* values only in
# lib/assistantModel.ts, both of which begin with `import "server-only"` — so
# importing either from a Client Component is a build error rather than a
# convention someone has to remember.

# --- gateway ----------------------------------------------------------------
# The read-only run gateway this app projects. The browser never talks to it
# directly; every page fetches it server-side.
GATEWAY_URL=http://127.0.0.1:8010

# --- telemetry --------------------------------------------------------------
# @copilotkit/runtime sends anonymous telemetry by default (a real outbound
# call this repo's other services do not make without being asked). Off by
# default here, matching this project's existing rule that nothing leaves the
# machine that was not explicitly turned on — see docs/judge_setup.md.
COPILOTKIT_TELEMETRY_DISABLED=true

# --- assistant model --------------------------------------------------------
# Any OpenAI-compatible endpoint: Ollama, vLLM, LM Studio, or OpenAI itself.
# Leave these unset and the assistant page says "Assistant model is not
# configured" and renders no chat box — the rest of the site (status, timeline,
# report, provenance) needs no model and works either way.
#
# The /v1 suffix matters for Ollama: it serves its own API at /api/... and an
# OpenAI-compatible one at /v1, and only the second is what this speaks. This
# is the same endpoint convention as the project's judge — see .env.example at
# the repository root and docs/judge_setup.md, including its "what leaves your
# machine" section, before pointing this at a cloud provider.
#
# The lab DGX, which serves the judge's own default model:
# ASSISTANT_MODEL_BASE_URL=http://lsbnb-dgx2.iis.sinica.edu.tw:11434/v1
#
# Ollama on this machine:
# ASSISTANT_MODEL_BASE_URL=http://localhost:11434/v1
#
# OpenAI:
# ASSISTANT_MODEL_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL_BASE_URL=

# Required, never defaulted. A model picked for you is a confident wrong answer
# waiting to happen — the same reason `annotate_cells` lists its 61 CellTypist
# candidates and stops rather than guessing one. Must support tool calling, or
# the assistant can talk but cannot look anything up.
# Verified working against the lab DGX: gpt-oss:120b
ASSISTANT_MODEL_NAME=

# Optional. Ollama and vLLM ignore it; OpenAI requires it. Defaults to
# "not-needed" when blank, exactly as the judge's SCRNA_JUDGE_API_KEY does.
# This value is read in one function, passed straight into the OpenAI client,
# and never logged, returned, rendered or written to a fixture.
ASSISTANT_MODEL_API_KEY=

# --- analysis controller (the write side) ------------------------------------
# Leave unset and this app is exactly what it has always been: a read-only
# projection. /analysis/new then says so plainly and points at the CLI, and a
# run page shows the pending gate without accept / revise / stop controls.
#
# Set it and the app can prepare an analysis request, record an explicit human
# confirmation, and answer a human gate. Nothing about the scientific executor
# changes: the controller only validates and queues, and a separate worker
# running in the dcode-scrna environment is the only thing that executes.
#
# Read only in lib/controller.ts, which begins with `import "server-only"`, so
# the browser never learns this address — which matters more here than for the
# gateway, because this is the service that can start an analysis. It is on the
# list `npm run test:bundle` checks.
#
# See services/controller/README.md for how to run it.
ANALYSIS_CONTROLLER_URL=

# Who a confirmation and a gate decision are recorded as.
#
# There is no authentication in this slice. Unset in development this becomes
# `local-operator`, which honestly identifies whoever is running the server
# rather than whoever is at the browser — two people sharing a local stack are
# recorded as one.
#
# Unset in production it is a *refusal*, not a fallback: a run whose gates were
# answered by "someone" is a run whose decisions cannot be attributed, and this
# project's provenance rests on the audit log. Set it, or set
# ANALYSIS_ALLOW_LOCAL_OPERATOR=true to accept the placeholder deliberately.
ANALYSIS_OPERATOR_ID=
